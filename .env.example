# Absolute path to the Obsidian agent vault on the host.
OBSIDIAN_VAULT_HOST_PATH=/absolute/path/to/agent-vault
# Standalone Reflect API configuration (no Hermes runtime or auth mount).
OBSIDIAN_MEMORY_REFLECT_PROVIDER=openai
OBSIDIAN_MEMORY_REFLECT_MODEL=your-model
OBSIDIAN_MEMORY_API_KEY=your-api-key
OBSIDIAN_MEMORY_API_BASE_URL=https://api.openai.com/v1
# Compose's read-only Codex login mount (only read if provider=codex).
CODEX_AUTH_HOST_PATH=/absolute/path/to/.codex/auth.json
