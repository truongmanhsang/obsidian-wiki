# Absolute path to the Obsidian agent vault on the host.
OBSIDIAN_VAULT_HOST_PATH=/absolute/path/to/agent-vault
# Absolute path to the Hermes state database used by session ingest.
HERMES_STATE_DB_HOST_PATH=/absolute/path/to/.hermes/state.db
# Existing Codex CLI login file; do not use Hermes auth.json.
CODEX_AUTH_HOST_PATH=/absolute/path/to/.codex/auth.json
# Set to codex to enable standalone Codex reflection.
OBSIDIAN_MEMORY_REFLECT_PROVIDER=hermes
# Required when OBSIDIAN_MEMORY_REFLECT_PROVIDER=codex.
OBSIDIAN_MEMORY_REFLECT_MODEL=your-codex-model
